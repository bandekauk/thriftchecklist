# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# From the Google Cloud OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma separated. Only these Google accounts can sign in.
ALLOWED_EMAILS=you@gmail.com,staff1@gmail.com,staff2@gmail.com

# --- Google Sheets ---
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# From the service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=shift-log@your-project.iam.gserviceaccount.com
# Paste the whole private_key value including the BEGIN/END lines, in quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
